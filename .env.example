# ─────────────────────────────────────────────────────────────────────────────
# Dhaka Tesla Pool — environment template
# Copy it, never commit the copy:   cp .env.example .env
# Every value below is validated when the API boots (docs/security.md §6);
# a missing or too-short JWT secret fails the boot loudly, by design.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres (docs/database.md, docs/deployment.md §1) ---
# The Compose `db` service builds its own DATABASE_URL from the three variables
# below, so they matter for `docker compose up`. DATABASE_URL itself is what a
# *local* (non-Docker) run uses — point it at the Compose port, as shown.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=dhaka_tesla_pool
POSTGRES_PORT=5432

DATABASE_URL=postgresql://app:app_password@localhost:5432/dhaka_tesla_pool

# --- API ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Both secrets must be >= 32 characters. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_please_change_me_32chars
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_me_32chars

# --- Tests (separate database for integration + concurrency suites) ---
DATABASE_URL_TEST=postgresql://app:app_password@localhost:5433/dhaka_tesla_pool_test

# --- Rate limits (docs/security.md §5) ---
# The middleware is always on; only the ceilings are configurable. The three
# buckets are deliberately separate: a page reload calls /auth/refresh, and that
# must never eat the budget that protects /auth/login.
#
# These are the values the local demo stack runs with, not the production
# defaults in code (100 / 10 / 30). One demo machine is several polling
# dashboards behind a single IP — two open dashboards alone are ~40 req/min —
# and a reviewer signing in and out repeatedly is nowhere near a brute-force
# attacker. A real deployment should use the code defaults, or lower.
RATE_LIMIT_MAX=300
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_MAX_REFRESH=60

# --- Demo affordances (off in a real deployment) ---
# SEED_DEMO_USERS=1 makes `prisma db seed` create the demo cast (Jashim, Nusrat,
# Rafiq, Shirin, Bullet) even when NODE_ENV=production, which is what the local
# Compose demo stack needs. NEXT_PUBLIC_DEMO_ACCOUNTS=1 renders the one-click
# sign-in buttons on /login. Set BOTH, or neither: the page must never advertise
# accounts the database does not have.
SEED_DEMO_USERS=1
NEXT_PUBLIC_DEMO_ACCOUNTS=1

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
