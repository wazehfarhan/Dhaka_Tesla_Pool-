# Frontend environment template (Phase 10). Copy to `frontend/.env.local` for local runs.
#
# Next inlines NEXT_PUBLIC_* at build time, so the same value must be present when
# `next build` runs (Phase 12/13 pass it into the image/build env).
# `lib/env.ts` falls back to http://localhost:4000 when this is unset, which is
# what `npm run dev:web` needs on a fresh clone.
NEXT_PUBLIC_API_URL=http://localhost:4000
